{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "movie": {
      "type": "application",
      "root": "apps/movie",
      "entryFile": "main",
      "sourceRoot": "apps/movie/src",
      "compilerOptions": {
        "tsConfigPath": "apps/movie/tsconfig.app.json"
      }
    },
    "rmq-env-config": {
      "type": "library",
      "root": "libs/rmq-env-config",
      "entryFile": "index",
      "sourceRoot": "libs/rmq-env-config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/rmq-env-config/tsconfig.lib.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    },
    "track": {
      "type": "application",
      "root": "apps/track",
      "entryFile": "main",
      "sourceRoot": "apps/track/src",
      "compilerOptions": {
        "tsConfigPath": "apps/track/tsconfig.app.json"
      }
    }
  }
}