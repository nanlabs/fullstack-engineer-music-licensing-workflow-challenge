# =============================================================================
# ACME BROS Music Licensing Workflow API - Environment Variables
# =============================================================================
# Copy this file to .env and update values as needed for your environment.
# Never commit .env files to version control (already in .gitignore)
# =============================================================================

# =============================================================================
# APPLICATION CONFIGURATION (Required)
# =============================================================================

# Server port number
# Default: 3000
PORT=3000

# Application environment: development, production, or test
# Default: development
NODE_ENV=development

# API route prefix (e.g., /api)
# Default: api
API_PREFIX=api

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================

# Database host address
# Default: localhost
DB_HOST=localhost

# Database port number
# Default: 5432
DB_PORT=5432

# Database username
# Required: Yes (no default)
DB_USERNAME=postgres

# Database password
# Required: Yes (no default)
DB_PASSWORD=postgres

# Database name
# Required: Yes (no default)
DB_NAME=acme_bros_db

# Enable database synchronization (auto-create/update tables)
# ⚠️ WARNING: Never use in production! Only for development.
# Default: false
DB_SYNC=false

# =============================================================================
# DATABASE CONNECTION POOL CONFIGURATION (Optional)
# =============================================================================

# Maximum number of database connections in the pool
# Default: 20
DB_POOL_MAX=20

# Minimum number of database connections in the pool
# Default: 5
DB_POOL_MIN=5

# Idle timeout for database connections (milliseconds)
# Default: 30000 (30 seconds)
DB_POOL_IDLE_TIMEOUT=30000

# Connection timeout for database connections (milliseconds)
# Default: 2000 (2 seconds)
DB_POOL_CONNECTION_TIMEOUT=2000

# =============================================================================
# CORS CONFIGURATION (Optional)
# =============================================================================

# Enable CORS (Cross-Origin Resource Sharing)
# Default: true
CORS_ENABLED=true

# Comma-separated list of allowed origins for CORS
# Default: http://localhost:3000,http://localhost:3001
# Example: http://localhost:3000,https://example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# RATE LIMITING CONFIGURATION (Optional)
# =============================================================================

# Rate limit time window in milliseconds
# Default: 60000 (60 seconds)
RATE_LIMIT_TTL=60000

# Maximum number of requests allowed per time window
# Default: 100
RATE_LIMIT_MAX=100

# =============================================================================
# PAGINATION CONFIGURATION (Optional)
# =============================================================================

# Default page number for paginated endpoints
# Default: 1
PAGINATION_DEFAULT_PAGE=1

# Default number of items per page
# Default: 10
PAGINATION_DEFAULT_LIMIT=10

# Maximum number of items allowed per page
# Default: 100
PAGINATION_MAX_LIMIT=100

# =============================================================================
# HEALTH CHECK CONFIGURATION (Optional)
# =============================================================================

# Memory heap threshold in bytes (for health checks)
# Default: 157286400 (150 MB)
# Production recommendation: Adjust based on your server capacity
HEALTH_CHECK_MEMORY_HEAP_THRESHOLD=157286400

# Memory RSS threshold in bytes (for health checks)
# Default: 157286400 (150 MB)
# Production recommendation: Adjust based on your server capacity
HEALTH_CHECK_MEMORY_RSS_THRESHOLD=157286400

# Liveness memory threshold in bytes (for liveness probes)
# Default: 314572800 (300 MB)
# Production recommendation: Adjust based on your server capacity
HEALTH_CHECK_LIVENESS_MEMORY_THRESHOLD=314572800

# Disk usage threshold as a decimal (0.0 to 1.0)
# Default: 0.9 (90%)
# Example: 0.85 = 85% disk usage threshold
HEALTH_CHECK_DISK_THRESHOLD_PERCENT=0.9

# =============================================================================
# SERVER-SENT EVENTS (SSE) CONFIGURATION (Optional)
# =============================================================================

# SSE heartbeat interval in milliseconds
# Sends periodic heartbeat messages to keep connections alive
# Default: 30000 (30 seconds)
SSE_HEARTBEAT_INTERVAL=30000

# Maximum number of concurrent SSE connections
# Default: 1000
# Production recommendation: Adjust based on your server capacity
SSE_MAX_CONNECTIONS=1000

# =============================================================================
# REQUEST CONFIGURATION (Optional)
# =============================================================================

# Request timeout in milliseconds
# Requests exceeding this time will be terminated
# Default: 30000 (30 seconds)
REQUEST_TIMEOUT=30000

# Maximum request body size limit
# Default: 10mb
# Examples: 10mb, 1gb, 50kb
REQUEST_BODY_SIZE_LIMIT=10mb

# =============================================================================
# TRANSFORM INTERCEPTOR CONFIGURATION (Optional)
# =============================================================================

# Comma-separated list of paths to skip response transformation
# These paths will return raw responses without the standard API wrapper
# Default: /health,/docs
TRANSFORM_INTERCEPTOR_SKIP_PATHS=/health,/docs

# Comma-separated list of HTTP status codes to skip transformation
# Responses with these status codes will not be wrapped
# Default: 204
TRANSFORM_INTERCEPTOR_SKIP_STATUS_CODES=204

# =============================================================================
# QUICK START GUIDE
# =============================================================================
# For local development, you only need to configure:
# - DB_USERNAME
# - DB_PASSWORD
# - DB_NAME
#
# All other variables have sensible defaults and can be customized later.
# See README.md for detailed documentation.
# =============================================================================
