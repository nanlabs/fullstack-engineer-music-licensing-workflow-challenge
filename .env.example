# PostgreSQL
POSTGRES_DB=music_licensing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgres://postgres:postgres@localhost:5432/music_licensing
JWT_SECRET=dev-secret-key-change-in-production-must-be-32-chars
RUST_LOG=info
CORS_ORIGIN=*
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=3000
# Set to true to build the frontend against the in-memory mock API instead
# of the real backend (offline UI development only).
VITE_USE_MOCK_API=false
