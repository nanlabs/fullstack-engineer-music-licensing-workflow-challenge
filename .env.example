# Copy to `.env` — read by `docker compose`. All values have defaults, so the
# stack also comes up with no `.env` present.

POSTGRES_USER=acme_user
POSTGRES_PASSWORD=acme_password
POSTGRES_DB=acme_music_db

# Host ports. Change these if 5432 or 3000 are already taken on your machine.
POSTGRES_PORT=5432
BACKEND_PORT=3000

# Log level for the backend (see tracing-subscriber's EnvFilter syntax).
RUST_LOG=info

# ---------------------------------------------------------------------------
# Running the API outside Docker (`cd backend && cargo run`) instead reads
# `backend/.env`. Copy `backend/.env.example` there — it points at localhost.
# ---------------------------------------------------------------------------
