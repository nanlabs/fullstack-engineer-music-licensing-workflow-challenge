# ---------------------------------------------------------------------------
# Copy to .env. Values below are development defaults; never use them in prod.
# ---------------------------------------------------------------------------

# Server
APP_ENV=development            # development | test | production
HOST=0.0.0.0
PORT=8080
BACKEND_PORT=8080              # host port published by docker compose
CORS_ORIGINS=http://localhost:5173
LOG_FORMAT=pretty              # pretty | json (json is the default outside development)
RUST_LOG=info,sqlx=warn,actix_server=warn
SHUTDOWN_TIMEOUT=30s

# Database (docker compose overrides DATABASE_URL with the in-network host)
POSTGRES_USER=licensing
POSTGRES_PASSWORD=licensing
POSTGRES_DB=licensing
POSTGRES_PORT=5432
DATABASE_URL=postgres://licensing:licensing@localhost:5432/licensing
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT=5s

# IAM
JWT_SECRET=development-secret-change-me-please-32-bytes-min
JWT_ISSUER=music-licensing
JWT_AUDIENCE=music-licensing-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
OTP_CODE_LENGTH=6
OTP_EXPIRATION_TIME=10m
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW=1m
SESSION_MAX_PER_USER=10
SESSION_CLEANUP_INTERVAL=1h
INVITATION_TTL=7d
COOKIE_ACCESS_TOKEN_NAME=access_token
COOKIE_REFRESH_TOKEN_NAME=refresh_token
COOKIE_SECURE=false            # true behind HTTPS
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax           # lax | strict | none
COOKIE_DOMAIN=
COOKIE_PATH=/

# Telemetry. Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to log to stdout only.
# With `docker compose --profile datadog up` set it to http://datadog-agent:4317
SERVICE_NAME=music-licensing-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=development
DD_HOSTNAME=music-licensing-local
