# ---------------------------------------------------------------------------
# Copy to .env. Values below are development defaults; never use them in prod.
# ---------------------------------------------------------------------------

# Server
APP_ENV=development            # development | test | production
HOST=0.0.0.0
PORT=8080
BACKEND_PORT=8080              # host port published by docker compose
FRONTEND_PORT=5173             # host port of the nginx-served SPA (same as the Vite dev server)
CORS_ORIGINS=http://localhost:5173
LOG_FORMAT=pretty              # pretty | json (json is the default outside development)
RUST_LOG=info,sqlx=warn,actix_server=warn
SHUTDOWN_TIMEOUT=30s

# Database (docker compose overrides DATABASE_URL with the in-network host)
POSTGRES_USER=licensing
POSTGRES_PASSWORD=licensing
POSTGRES_DB=licensing
POSTGRES_PORT=5432
DATABASE_URL=postgres://licensing:licensing@localhost:5432/licensing
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT=5s

# IAM
JWT_SECRET=development-secret-change-me-please-32-bytes-min
JWT_ISSUER=music-licensing
JWT_AUDIENCE=music-licensing-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
OTP_CODE_LENGTH=6
OTP_EXPIRATION_TIME=10m
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW=1m
SESSION_MAX_PER_USER=10
SESSION_CLEANUP_INTERVAL=1h
INVITATION_TTL=7d
COOKIE_ACCESS_TOKEN_NAME=access_token
COOKIE_REFRESH_TOKEN_NAME=refresh_token
COOKIE_SECURE=false            # true behind HTTPS
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax           # lax | strict | none
COOKIE_DOMAIN=
COOKIE_PATH=/

# Notifications (OTP codes and invitations). Only the console provider exists:
# every message is printed, fully rendered, to the backend log. Development only.
NOTIFY_PROVIDER=console
NOTIFY_FROM_ADDRESS=no-reply@music-licensing.local
NOTIFY_FROM_NAME=Music Licensing
# Public origin of the frontend; invitation links point to
# $APP_PUBLIC_URL/accept-invitation#token=...
APP_PUBLIC_URL=http://localhost:5173

# Licensing. How often approved licenses past their expires_at are moved to expired.
LICENSE_EXPIRY_SWEEP_INTERVAL=5m

# Real-time (GET /api/v1/events, Server-Sent Events)
SSE_KEEP_ALIVE_INTERVAL=15s    # comment line that keeps idle streams open through proxies
SSE_MAX_CONNECTION_AGE=15m     # streams are closed after this; the browser reconnects and re-authenticates
SSE_REPLAY_LIMIT=500           # events one read of the log delivers (on reconnect or live) before a resync is requested
# Empty = in-process event bus (single backend instance). docker compose sets
# redis://redis:6379 so every instance hears every license change.
REDIS_URL=
REDIS_PORT=6379

# Telemetry. Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to log to stdout only.
# With `docker compose --profile datadog up` set it to http://datadog-agent:4317
SERVICE_NAME=music-licensing-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=development
DD_HOSTNAME=music-licensing-local
