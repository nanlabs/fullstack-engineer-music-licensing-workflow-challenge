# Address the HTTP server binds to. Defaults to 0.0.0.0:8080 when unset.
HTTP_BIND_ADDRESS=0.0.0.0:8080

# PostgreSQL connection string used by migrate, seed and serve.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/music_licensing

# SQLx request pool sizing. The PgListener connection is separate from this pool.
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT=2s

# High-entropy secret, at least 32 bytes. Required: there is no source-code fallback.
# Development only; generate a fresh secret per environment (openssl rand -base64 48).
JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-data

# Issuer and audience stamped on issued tokens and required on incoming ones.
# Override these to match your identity provider when one fronts this API.
JWT_ISSUER=music-licensing-api
JWT_AUDIENCE=music-licensing-clients

# Lifetime of an issued development token. Bare numbers are seconds; `60m` and
# `500ms` also work.
JWT_TOKEN_TTL=3600

# Mounts POST /auth/dev-token, which issues tokens WITHOUT credentials: any
# caller can claim any display name. Development only; must be false elsewhere.
# When false the route is not mounted at all and requests get an ordinary 404.
DEV_TOKEN_ENDPOINT_ENABLED=true

# Comma-separated CORS allowlist. Never a wildcard in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Maximum concurrent SSE connections per process.
SSE_MAX_CONNECTIONS=1000
