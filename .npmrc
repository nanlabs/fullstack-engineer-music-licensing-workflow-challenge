# npm configuration file
# See: https://docs.npmjs.com/cli/v9/configuring-npm/npmrc

# Save exact versions (not ranges) in package.json
save-exact=false

# Use package-lock.json
package-lock=true

# Don't create package-lock.json for optional dependencies
package-lock-only=false

# Log level
loglevel=warn

# Audit level
audit-level=moderate

# Fund messages
fund=false

# Update notifications
update-notifier=false
