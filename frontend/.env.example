# Backend API base URL. Leave unset (or empty) for same-origin requests —
# Vite proxy (dev) and Nginx (Docker) forward /api to the backend.
# Set to a full URL when the backend is on a different origin, e.g.
# for an AWS deployment: VITE_API_URL=https://api.example.com/api
# VITE_API_URL=

# Set to "true" to use the in-memory mock API instead of the real backend.
# Defaults to false — the app always talks to the real backend unless this
# is explicitly enabled (useful for offline UI development).
VITE_USE_MOCK_API=false
